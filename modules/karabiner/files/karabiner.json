                "to": [
                  { "set_variable": { "name": "builtin_kbd_off", "value": 0 } },
                  { "set_notification_message": { "id": "builtin_kbd_off", "text": "" } },
                  { "shell_command": "/usr/bin/pkill -x nopaw" }
